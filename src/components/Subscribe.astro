---
import { SITE } from '../consts';
---

<section class="subscribe">
  <h2>Subscribe</h2>
  <p>New writing and projects by email</p>

  <!--
    A plain POST to Buttondown, opened in a new tab so Buttondown can show its
    own confirmation (and a spam check when it wants one). Works without JS.
  -->
  <form action={SITE.newsletterAction} method="post" target="_blank" data-subscribe>
    <label class="visually-hidden" for="bd-email">
      Email address
    </label>
    <input
      id="bd-email"
      type="email"
      name="email"
      placeholder="you@example.com"
      autocomplete="email"
      required
    />
    <input type="hidden" name="embed" value="1" />
    <button type="submit">Subscribe</button>
  </form>
  <p class="status" role="status" hidden>
    Almost done — check your inbox for a confirmation email.
  </p>
</section>

<script>
  // Count signups in GA (gtag only exists on the live site) and confirm in
  // place, since the Buttondown tab may open behind this one.
  const { gtag } = window as { gtag?: (...args: unknown[]) => void };

  document.querySelectorAll<HTMLFormElement>('form[data-subscribe]').forEach((form) => {
    form.addEventListener('submit', () => {
      gtag?.('event', 'newsletter_signup', { page_path: location.pathname });
      const status = form.nextElementSibling as HTMLElement | null;
      // Let the POST go out before clearing the field.
      setTimeout(() => {
        form.reset();
        if (status) status.hidden = false;
      });
    });
  });
</script>

<style>
  .subscribe {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  h2 {
    font-size: var(--text-lg);
  }

  p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    margin-top: var(--space-1);
  }

  form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }

  input {
    flex: 1 1 16rem;
    min-width: 0;
    padding: var(--space-1) var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 3px;
  }

  input:focus-visible {
    border-color: var(--color-accent);
  }

  button {
    padding: var(--space-1) var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-bg);
    background: var(--color-text);
    border: 1px solid var(--color-text);
    border-radius: 3px;
    cursor: pointer;
  }

  button:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .status {
    color: var(--color-text);
    margin-top: var(--space-2);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
