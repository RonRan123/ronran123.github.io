---
import { cleanPath } from '../lib/url';

const pathname = cleanPath(Astro.url.pathname);
const links = [
  { href: '/writing',  label: 'Writing'  },
  { href: '/projects', label: 'Projects' },
  { href: '/resume',   label: 'Resume'   },
];
const isActive = (href: string) => pathname === href || pathname.startsWith(href + '/');
---

<header class="site-header">
  <nav class="wrap" aria-label="Main">
    <a href="/" class="name">Ronith Ranjan</a>
    <ul>
      {links.map(({ href, label }) => (
        <li>
          <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background: var(--color-nav-bg);
    border-bottom: 1px solid var(--color-border);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-3);
    font-family: var(--font-sans);
  }

  .name {
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .name:hover { color: var(--color-accent); }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    font-size: var(--text-sm);
  }

  ul a {
    color: var(--color-text-muted);
    text-decoration: none;
    /* Comfortable touch target on mobile without visually padding the row */
    display: inline-block;
    padding-block: var(--space-1);
    margin-block: calc(var(--space-1) * -1);
  }

  ul a:hover,
  ul a[aria-current='page'] { color: var(--color-text); }

  ul a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }
</style>
