---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getProjects, formatDate } from '../../lib/content';
import { previewImage } from '../../lib/preview-image';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content, headings } = await render(project);
const { title, description, date, externalLink, externalLabel } = project.data;
const image = await previewImage(project.data.image);
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={image}
  contentGroup="projects"
>
  <article>
    <TableOfContents headings={headings} title={title} />
    <header>
      <h1>{title}</h1>
      {date && (
        <p class="ui date">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
        </p>
      )}
      {externalLink && (
        <p class="external">
          <a href={externalLink}>{externalLabel ?? 'View project'} →</a>
        </p>
      )}
    </header>

    <div class="prose body">
      <Content />
    </div>
  </article>

  <p class="back ui">
    <a href="/projects" data-track="post_back">
      ← All projects
    </a>
  </p>
</BaseLayout>

<style>
  article {
    position: relative; /* anchors the TableOfContents rail */
  }

  header {
    margin-bottom: var(--space-4);
  }
  .date {
    margin-top: var(--space-1);
  }

  .external {
    margin-top: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .external a {
    text-decoration: none;
  }
  .external a:hover {
    text-decoration: underline;
  }

  .body :global(h2) {
    font-size: var(--text-lg);
    margin-top: var(--space-4);
  }

  .body :global(ul),
  .body :global(ol) {
    padding-left: var(--space-3);
  }

  .body :global(h3) {
    font-size: var(--text-base);
    margin-top: var(--space-3);
  }

  .body :global(img) {
    margin-block: var(--space-3);
  }

  /* Caption: an italic line directly under an image in the Markdown. */
  .body :global(img + em) {
    display: block;
    margin-top: calc(-1 * var(--space-2));
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .back {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .back a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .back a:hover {
    color: var(--color-accent);
  }
</style>
