---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * Timeline content lives here rather than in a collection: it's one page,
 * edited as a unit, and a collection would be indirection with no payoff.
 * Source of record for the PDF is public/resume.pdf — keep the two in sync.
 */
const experience = [
  {
    period: 'Sept 2024 — Present',
    org: 'McKinsey & Company',
    role: 'Senior Business Analyst',
    place: 'New York, NY',
    notes: [
      'Product owner for a RAG-powered agentic sales tool, leading a 3-person team to automate B2B outreach and prospect research. Demoed to 15+ clients, several converting into new studies.',
      'Built an app rationalization model across 4,000+ enterprise applications and 6 business units, identifying $100M+ in savings and agentic AI capability gaps for a Fortune 500 CIO overseeing $1.5B in IT spend.',
      'Developed a growth playbook steering a leading semiconductor player’s IoT capabilities toward the physical AI opportunity — sizing and prioritizing 3 of 11 verticals, which the EVP funded.',
      'Applied an AI disruption-risk framework to two SaaS portfolio companies — moat strength, pricing resilience, competitive exposure — informing a PE firm’s investment and asset-prioritization decisions.',
    ],
  },
  {
    period: 'June 2024 — Aug 2024',
    org: 'City of Boston',
    role: 'Product Manager Fellow, Coding it Forward',
    place: 'Boston, MA',
    notes: [
      'Selected from 4,500+ applicants (2% acceptance) for the Coding it Forward civic technology fellowship.',
      'Ran user and event exploration across 13,000+ monthly users of the city’s open data portal, cutting the average clicks needed to reach the most-requested datasets.',
    ],
  },
  {
    period: 'May 2022 — May 2024',
    org: 'Forge',
    role: 'Engineering Director',
    place: 'Charlottesville, VA',
    notes: [
      'Designed and built the recruiting platform MVP serving 750+ students and 120+ companies, enabling a 15% faster match rate.',
      'Founded the tech consulting branch for short- and medium-term projects around the University community, growing engineering revenue 22%.',
      'Taught 71 students software engineering through a 140-hour course preparing them for a nine-week internship.',
    ],
  },
  {
    period: 'May 2022 — Sept 2022',
    org: 'Economics Department, UVA',
    role: 'AI Economics Research Assistant',
    place: 'Charlottesville, VA',
    notes: [
      'Worked with the editors of the forthcoming Oxford Handbook of AI Governance on podcast episodes and chapter summaries across 10+ chapters, from governance to risk mitigation.',
      'Built a web scraper collecting publishing and contact data on 1,500+ economists from RePEc.',
    ],
  },
  {
    period: 'Jan 2021 — May 2023',
    org: 'Computer Science Department, UVA',
    role: 'Teaching Assistant',
    place: 'Charlottesville, VA',
    notes: ['Substituted for the professor across 4 hour-long lectures, each on short notice.'],
  },
  {
    period: 'June 2021 — Aug 2021',
    org: 'CuriosityStream',
    role: 'Full Stack Software Engineer Intern',
    place: 'Silver Spring, MD',
    notes: [
      'Built the metadata management tool for the recommender system’s 4,000+ tags and 3,000+ titles, reporting to the CTO.',
    ],
  },
];

const education = [
  {
    period: 'Aug 2020 — May 2024',
    org: 'University of Virginia',
    role: 'BA Computer Science and Political & Social Thought; Economics minor',
    place: 'Charlottesville, VA',
    notes: [
      'Echols Scholar (top 5%). GPA 3.98.',
      'Wrote a 100-page thesis on the relationship between computational technology and state power.',
      'Neo Finalist 2023 — one of 150 students selected nationally from 1,000+ for CS skill and startup interest.',
      'Published a journal paper analyzing UVA’s data ecosystem and recommending a student-run open data community.',
      'Jefferson Literary and Debating Society; University Judiciary Committee; Senior Resident in Housing & Residence Life.',
    ],
  },
  {
    period: 'Aug 2016 — June 2020',
    org: 'Thomas Jefferson High School for Science and Technology',
    role: 'Student Body President and Class President',
    place: 'Alexandria, VA',
    notes: [
      'National Merit Finalist. US Senate Youth Program — one of two delegates for Virginia.',
    ],
  },
];
---

<BaseLayout
  title="Resume"
  description="Ronith Ranjan — experience, education, and a downloadable PDF resume."
>
  <h1>Resume</h1>

  <p class="lede">
    Currently a senior business analyst at McKinsey in New York, working mostly on AI products.
    Before that, computer science and Political &amp; Social Thought at UVA.
  </p>

  <p class="download">
    <a href="/resume.pdf">Download PDF →</a>
  </p>

  <section>
    <h2>Experience</h2>
    {experience.map((item) => (
      <article class="entry">
        <p class="period ui">{item.period}</p>
        <h3>{item.org}</h3>
        <p class="role ui">
          {item.role} · {item.place}
        </p>
        <ul>
          {item.notes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <section>
    <h2>Education</h2>
    {education.map((item) => (
      <article class="entry">
        <p class="period ui">{item.period}</p>
        <h3>{item.org}</h3>
        <p class="role ui">
          {item.role} · {item.place}
        </p>
        <ul>
          {item.notes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <section>
    <h2>Skills</h2>
    <p class="skills">
      Python, C++, JavaScript, HTML/CSS, Java, R. Spanish (fluent), Hindi (conversational).
    </p>
  </section>
</BaseLayout>

<style>
  .lede {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  .download {
    margin-top: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-base);
  }

  .download a {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    color: var(--color-bg);
    background: var(--color-text);
    border-radius: 3px;
    text-decoration: none;
  }

  .download a:hover {
    background: var(--color-accent);
  }

  section {
    margin-top: var(--space-5);
  }

  section h2 {
    font-size: var(--text-lg);
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--color-border);
  }

  .entry {
    margin-top: var(--space-4);
  }

  .period {
    margin-bottom: 0.1rem;
  }

  .entry h3 {
    font-size: var(--text-base);
    font-weight: 600;
  }

  .role {
    margin-top: 0.1rem;
  }

  .entry ul {
    margin-top: var(--space-1);
    padding-left: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .entry li + li {
    margin-top: var(--space-1);
  }

  .skills {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }
</style>
