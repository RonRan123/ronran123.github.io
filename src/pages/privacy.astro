---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

/**
 * Google Analytics' terms require disclosing GA, its cookies, and how Google
 * uses the data. Keep in step with src/components/Analytics.astro.
 */
---

<BaseLayout title="Privacy" description="What this site tracks and how to opt out.">
  <h1>Privacy</h1>

  <div class="prose body">
    <p>
      I use Google Analytics to see which posts people read and how they found them. This helps me
      improve the content and ensure that I'm writing valuable content for my readers. It sets a
      cookie and records things like the pages you visit, the link that brought you here, and your
      device and where you are reading from. I only see totals, and I don't run ads or sell
      anything. Google handles the data under
      <a href="https://policies.google.com/technologies/partner-sites">its own policy</a>.
    </p>
    <p>If you'd rather not be counted, you can turn it off for this browser:</p>
  </div>

  <button type="button" id="optout-toggle" hidden></button>

  <div class="prose body">
    <p>
      Questions? Email me at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
    </p>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var button = document.getElementById('optout-toggle');
    var optOut = window.analyticsOptOut; // defined by Analytics.astro in <head>

    function render() {
      button.textContent = optOut.get() ? 'Analytics is off · turn back on' : 'Turn off analytics';
      button.hidden = false;
    }

    button.addEventListener('click', function () {
      optOut.set(!optOut.get());
      render();
    });

    render();
  })();
</script>

<style>
  .body {
    margin-top: var(--space-3);
  }

  button {
    margin-top: var(--space-2);
    padding: var(--space-1) var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-bg);
    background: var(--color-text);
    border: 1px solid var(--color-text);
    border-radius: 3px;
    cursor: pointer;
  }

  button:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
