---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { SITE } from '../consts';
import { cleanPath } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Overrides the default OG image for a specific page. `null` omits the
      image entirely, so shares show a compact title-only preview. */
  image?: string | null;
  /** 'article' for blog posts, 'website' otherwise. */
  type?: 'website' | 'article';
  publishedDate?: Date;
  /** Analytics content group: 'writing' | 'projects' | 'home' | 'page'. */
  contentGroup?: string;
}

const {
  title,
  description = SITE.description,
  image = '/images/ronith-800.jpg',
  type = 'website',
  publishedDate,
  contentGroup = 'page',
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site);
const ogImage = image ? new URL(image, Astro.site) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL('/rss.xml', Astro.site)}
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:site_name" content={SITE.title} />
    {publishedDate && (
      <meta property="article:published_time" content={publishedDate.toISOString()} />
    )}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <Analytics contentGroup={contentGroup} />
  </head>

  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <Nav />
    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
